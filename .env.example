# URL pública da API do backend, sem barra final.
VITE_AGENDAI_API_URL=http://localhost:3000
# Token temporário que substitui o Firebase App Check quando definido.
# Deve ser igual a APP_AUTH_TEST_TOKEN do backend. Não use em produção.
VITE_APP_AUTH_TEST_TOKEN=
# Token Firebase App Check válido para o ambiente de desenvolvimento browser.
VITE_FIREBASE_APP_CHECK_TOKEN=
